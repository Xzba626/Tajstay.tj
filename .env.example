# PostgreSQL only (SQLite is not supported). After changing prisma/schema.prisma provider, run: npx prisma generate
#
# Vercel (Production + Preview) — required:
#   DATABASE_URL          — Neon / Supabase / Vercel Postgres connection string (?sslmode=require)
#   AUTH_SECRET           — >=32 chars: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   AUTH_URL, NEXTAUTH_URL — https://your-domain.vercel.app (or custom domain)
# Optional: GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, COMMISSION_RATE, SERVICE_FEE_RATE, TAX_RATE, FX_TJS_USD
# Admin security form (secret word — not login password). Default if unset in DB: tajstay-secret
# ADMIN_SECRET_WORD="tajstay-secret"
# Emergency reset in /dashboard/admin (requires admin session + this env, >=16 chars):
# ADMIN_SECURITY_RESET_SECRET=""
# Vercel Blob for hotel/room photo uploads on production (auto from Storage → Blob):
# BLOB_READ_WRITE_TOKEN=""
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tajstay?schema=public"
COMMISSION_RATE=0.12
SERVICE_FEE_RATE=0.03
TAX_RATE=0.05
FX_TJS_USD=10.9

# Auth.js / NextAuth (Google optional)
# Set a strong random secret (>=32 chars), e.g.:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# Публичный URL сайта (обязательно https вашего домена за туннелем / в проде).
# Локально без туннеля: http://localhost:3000
# Через Cloudflare Tunnel: https://ваш-домен.tld (и в Google Console те же origin + redirect URI).
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Без обоих значений кнопка «Google» скрыта; иначе Google отвечает: Missing required parameter: client_id
GOOGLE_CLIENT_ID="990250658047-5k69ikcbioba043s1l071csj46jn121o.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="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"
# Google OAuth: сервер Next делает fetch к accounts.google.com. Ошибка fetch failed = нет исходящего HTTPS/DNS (файрвол, антивирус, VPN). npm run dev включает для Node --dns-result-order=ipv4first (scripts/dev-normalized.mjs).

# Firebase Phone Auth (SMS OTP) — NOT the same as VAPID (push notifications).
# Console: Project settings → Your apps → Web app → firebaseConfig
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
# Server: Firebase Admin (Project settings → Service accounts → Generate new private key)
# Option A — paste full JSON (one line) from the downloaded key file:
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Option B — separate fields:
# FIREBASE_PROJECT_ID=""
# FIREBASE_CLIENT_EMAIL=""
# FIREBASE_PRIVATE_KEY=""   # use \n for newlines inside the key

# Telegram login (@TajstayBot) — webhook: POST https://your-domain/api/telegram/webhook
TELEGRAM_BOT_TOKEN="8917821313:AAGpySCkDI402CMY0zshZk01yrGm2xueOgc"
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME="Tajstay_Bot"
# Optional: set when registering webhook (secret_token)
TELEGRAM_WEBHOOK_SECRET="TELEGRAM_WEBHOOK_SECRET=8fK29sTajstayTelegramWebhookSecret2026"
# Optional: HMAC secret for login codes (defaults to AUTH_SECRET)
TELEGRAM_LOGIN_SECRET="TELEGRAM_LOGIN_SECRET=Kf92jTajstayTelegramLoginSecretXz2026"

# Dev seed API only
SEED_SECRET="change-me-dev-secret"
SEED_ALLOW_INSECURE_DEV=0
PRISMA_LOG_QUERIES=0
