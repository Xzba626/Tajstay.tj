generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL — app queries (Neon pooler OK).
// DIRECT_URL — migrations only: Neon *non-pooler* host (without `-pooler`), else P1002 advisory lock timeouts on Vercel.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  name             String
  phone            String    @unique
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  password         String
  /// Firebase Auth UID after phone sign-in (production SMS OTP).
  firebaseUid      String?   @unique
  /// True when phone was verified via Firebase Phone Auth (or legacy OTP).
  phoneVerified    Boolean   @default(false)
  /// Telegram user id (string for large ids).
  telegramId       String?   @unique
  telegramUsername String?
  telegramPhotoUrl String?
  role             String    @default("GUEST")
  verified         Boolean   @default(false)
  isBanned         Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  hotels                 Hotel[]              @relation("OwnerHotels")
  bookings               Booking[]            @relation("BookingUser")
  offlineBookingsCreated Booking[]            @relation("BookingsCreatedByOwner")
  reviewedBookings       Booking[]            @relation("BookingProofReviewedBy")
  notes                  Notification[]       @relation("UserNotifications")
  sessions               Session[]
  passwordResetTokens    PasswordResetToken[]
  emailOtps              EmailOtp[]
  favorites              Favorite[]
  complaints             Complaint[]
  accounts               Account[]
  ownerApplications      OwnerApplication[]   @relation("OwnerApplications")
  reviewedOwnerApps      OwnerApplication[]   @relation("OwnerApplicationReviewedBy")

  hostProfile         HostProfile?
  paymentMethodsEntry OwnerPaymentMethod?
  payments            Payment[]
  payouts             Payout[]            @relation("UserPayouts")
  disputesOpened      Dispute[]           @relation("DisputesOpened")
  disputesAgainst     Dispute[]           @relation("DisputesAgainst")
  pushSubscriptions   PushSubscription[]
  notificationPreference NotificationPreference?
  hotelStaffMemberships HotelStaff[]

  // Local Vault (Phase 2B.1)
  localVaultCodesCreated     LocalVaultActivationCode[] @relation("LocalVaultCodeCreatedBy")
  localVaultDevicesActivated LocalVaultDeviceBinding[]  @relation("LocalVaultDeviceActivatedBy")
  localVaultDevicesRevoked   LocalVaultDeviceBinding[]  @relation("LocalVaultDeviceRevokedBy")
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Заявка на статус владельца; доступ к owner panel только после APPROVED.
model OwnerApplication {
  id              Int       @id @default(autoincrement())
  userId          Int
  user            User      @relation("OwnerApplications", fields: [userId], references: [id])
  fullName        String
  phone           String
  email           String
  businessName    String
  documentUrl     String?
  comment         String?
  /// Extended onboarding: property details, upload URLs, applicant type (JSON).
  applicationMeta Json?
  status          String    @default("PENDING")
  createdAt       DateTime  @default(now())
  reviewedAt      DateTime?
  reviewedById    Int?
  reviewedBy      User?     @relation("OwnerApplicationReviewedBy", fields: [reviewedById], references: [id])
}

model Hotel {
  id            Int      @id @default(autoincrement())
  owner         User     @relation("OwnerHotels", fields: [ownerId], references: [id])
  ownerId       Int
  name          String
  city          String
  address       String
  description   String
  propertyType  String   @default("HOTEL")
  /// URL обложки (внешняя ссылка или /uploads/…)
  coverImageUrl String?
  rating        Float    @default(0)
  status        String   @default("PENDING")
  /// Current-state reason for the current `status` when REJECTED (null once resubmitted or
  /// approved) - AdminAuditLog stays the append-only history of every past transition, this is
  /// the one field the Owner-facing UI actually reads. Never infer "why is my Hotel rejected"
  /// from the latest audit row - that conflates history with current state and breaks the moment
  /// there's a reject -> resubmit -> reject cycle.
  currentRejectionReason String?
  latitude      Float
  longitude     Float
  /// BLOCK 5.4B - explicit owner opt-in for guest "pay at check-in" bookings (instant CONFIRMED,
  /// no online payment/proof). Defaults false so no existing hotel silently starts accepting
  /// unpaid reservations after this field ships - see docs/TAJSTAY_ARCHITECTURE_V2.md and
  /// BLOCK_5.4A_ARCHITECTURE_REPORT.md for why this couldn't just reuse PENDING_OWNER.
  acceptsPayAtCheckIn Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  rooms     Room[]
  roomTypes RoomType[]
  staff     HotelStaff[]
  favorites Favorite[]

  photos         HotelPhoto[]
  amenities      HotelAmenity[]
  paymentMethods HotelPaymentMethod[]
  subscription   HotelSubscription?
  expenses       HotelExpense[]
  ownerAuditLogs OwnerHotelAuditLog[]

  // Local Vault (Phase 2B.1)
  localVaultActivationCodes LocalVaultActivationCode[]
  localVaultDevices         LocalVaultDeviceBinding[]
  bookingDeliveryChanges    BookingDeliveryChange[]
  deliveryCursor            HotelDeliveryCursor?
}

/// Per-Hotel TajStay subscription (canonical revenue: 0% booking commission, Hotel pays a
/// monthly platform subscription instead). One row per Hotel, created exactly once - the first
/// time that specific Hotel transitions PENDING -> APPROVED - and never again, even if the Hotel
/// is later suspended/reactivated. See HotelSubscription creation in
/// /api/admin/hotels/moderate/route.ts.
model HotelSubscription {
  id                 Int       @id @default(autoincrement())
  hotelId            Int       @unique
  hotel              Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  /// TRIAL | ACTIVE | PAST_DUE | SUSPENDED | CANCELLED
  status             String    @default("TRIAL")
  /// Immutable anchor - the Hotel's first-ever APPROVED timestamp. Never reset by a later
  /// re-approval/reactivation.
  trialStartAt       DateTime
  /// Calendar-month from trialStartAt (date-fns addMonths, not a blind 30-day offset).
  trialEndAt         DateTime
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  periods SubscriptionPeriod[]

  @@index([status])
}

/// One billed (or free-trial) period for a Hotel's subscription. Three DELIBERATELY separate
/// money fields - conflating them is exactly how a free trial month ends up counted as revenue:
/// - `tariffSnapshot`: the platform's list price AT THE TIME this period was created, frozen
///   independent of later PlatformSetting changes (same pattern as HotelPaymentMethod). This is
///   "what the tariff was", not "what was charged" - a FREE trial period still records it, purely
///   for reference/audit, and it must NEVER be read as revenue.
/// - `amountDue`: what this specific period actually owes. 0 for FREE, equal to tariffSnapshot
///   (normally) for a real paid period.
/// - `amountPaid`: what has actually been collected so far. 0 until a real payment is confirmed;
///   for FREE it stays 0 forever (nothing was ever owed).
/// TajStay subscription revenue MUST be defined as SUM(amountPaid) WHERE status = 'PAID' - never
/// SUM(tariffSnapshot), and never inferred from status + tariffSnapshot alone.
model SubscriptionPeriod {
  id              Int               @id @default(autoincrement())
  subscriptionId  Int
  subscription    HotelSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  /// PENDING | PAID | FREE
  status          String            @default("PENDING")
  currency        String            @default("TJS")
  tariffSnapshot  Decimal
  amountDue       Decimal           @default(0)
  amountPaid      Decimal           @default(0)
  paidAt          DateTime?
  createdAt       DateTime          @default(now())

  @@index([subscriptionId])
}

/// Singleton platform-wide business settings (Admin-only, audited). Currently just the
/// subscription monthly price - kept as its own tiny table rather than folded into
/// SiteContentState's JSON blob, since this is a financial control, not marketing/support copy.
model PlatformSetting {
  id                          Int      @id @default(1)
  subscriptionMonthlyPriceTjs Decimal  @default(99)
  updatedAt                   DateTime @updatedAt
  updatedById                 Int?
}

/// Категория номера (то, что видит гость): Стандарт, Полулюкс, …
model RoomType {
  id              Int      @id @default(autoincrement())
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId         Int
  name            String
  description     String?
  basePrice       Decimal
  weekendPrice    Decimal?
  minNights       Int      @default(1)
  extraGuestPrice Decimal?
  adults          Int      @default(2)
  children        Int      @default(0)
  maxGuests       Int
  bedsCount       Int      @default(1)
  /// JSON: ["double","twin","sofa",…]
  bedConfig       String   @default("[]")
  /// ROOM_ONLY | BREAKFAST | HALF_BOARD | FULL_BOARD
  mealPlan        String   @default("ROOM_ONLY")
  /// JSON categorized amenities (see lib/pms/amenities.ts)
  amenities       String   @default("[]")
  sortOrder       Int      @default(0)
  availability    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rooms     Room[]
  bookings  Booking[]       @relation("BookingRoomType")
  ratePlans RatePlan[]
  photos    RoomTypePhoto[]

  @@unique([hotelId, name])
  @@index([hotelId])
}

model RoomTypePhoto {
  id         Int      @id @default(autoincrement())
  roomTypeId Int
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
  /// PHOTO | PANO360
  kind       String   @default("PHOTO")
  /// Multi-scene 360 label (e.g. Bathroom) — null for ordinary photos
  sceneLabel String?
  createdAt  DateTime @default(now())

  @@index([roomTypeId])
  @@index([roomTypeId, kind])
}

/// Тариф (MVP: привязан к категории)
model RatePlan {
  id          Int      @id @default(autoincrement())
  roomTypeId  Int
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name        String
  /// Overrides meal on type when set
  mealPlan    String?
  refundable  Boolean  @default(true)
  isDefault   Boolean  @default(false)
  priceAdjust Decimal  @default(0)
  createdAt   DateTime @default(now())

  @@index([roomTypeId])
}

/// Физическая комната (101, 102, A-12) — управление владельцем/ресепшеном
model Room {
  id                 Int       @id @default(autoincrement())
  hotel              Hotel     @relation(fields: [hotelId], references: [id])
  hotelId            Int
  roomType           RoomType? @relation(fields: [roomTypeId], references: [id])
  roomTypeId         Int?
  /// Номер комнаты в отеле (уникален в рамках hotelId)
  roomNumber         String?
  title              String
  price              Decimal
  weekendPrice       Decimal?
  minNights          Int       @default(1)
  extraGuestPrice    Decimal?
  capacity           Int
  amenities          String // JSON stringified array (legacy + custom)
  /// JSON: extra amenities only on this physical room
  customAmenities    String    @default("[]")
  availability       Boolean   @default(true)
  /// ACTIVE | OUT_OF_SERVICE | MAINTENANCE | CLEANING | DIRTY | INSPECTED | HIDDEN | ARCHIVED
  status             String    @default("ACTIVE")
  /// CLEAN | DIRTY | CLEANING | INSPECTED
  housekeepingStatus String    @default("CLEAN")
  staffNote          String?

  overrides        RoomDateOverride[]
  bookings         Booking[]
  assignedBookings Booking[]          @relation("AssignedRoom")
  photos           RoomPhoto[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId])
  @@index([roomTypeId])
  @@index([status])
}

/// Hotel-scoped staff (Manager / reception). Access is never global across an owner's hotels.
model HotelStaff {
  id                 Int       @id @default(autoincrement())
  hotelId            Int
  hotel              Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId             Int
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// MANAGER | RECEPTIONIST | HOUSEKEEPING
  staffRole          String
  /// ACTIVE | INVITED | SUSPENDED | REMOVED
  status             String    @default("ACTIVE")
  inviteTokenHash    String?
  inviteExpiresAt    DateTime?
  mustChangePassword Boolean   @default(false)
  lastActiveAt       DateTime?
  createdByUserId    Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([hotelId, userId])
  @@index([userId])
  @@index([hotelId, status])
  @@index([inviteTokenHash])
}

/// Фото номера (галерея / слайдер на карточке и странице отеля).
model RoomPhoto {
  id         Int      @id @default(autoincrement())
  roomId     Int
  room       Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
  /// PHOTO | PANO360
  kind       String   @default("PHOTO")
  sceneLabel String?
  createdAt  DateTime @default(now())

  @@index([roomId])
  @@index([roomId, kind])
}

model RoomDateOverride {
  id          Int      @id @default(autoincrement())
  room        Room     @relation(fields: [roomId], references: [id])
  roomId      Int
  date        DateTime
  customPrice Decimal?
  isBlocked   Boolean  @default(false)

  @@unique([roomId, date])
}

model Booking {
  id                       Int                 @id @default(autoincrement())
  /// Public short code, e.g. TJ-7704 (shown to user for transfer comment)
  publicCode               String?             @unique
  /// PLATFORM = guest checkout; OWNER_MANUAL = offline booking by host
  source                   String              @default("PLATFORM")
  user                     User?               @relation("BookingUser", fields: [userId], references: [id])
  userId                   Int?
  createdByOwner           User?               @relation("BookingsCreatedByOwner", fields: [createdByOwnerId], references: [id])
  createdByOwnerId         Int?
  guestName                String?
  guestPhone               String?
  guestEmail               String?
  guestCount               Int                 @default(1)
  offlineNote              String?
  /// OWNER_MANUAL lifecycle: PENDING | CONFIRMED | CHECKED_IN | CHECKED_OUT | CANCELLED
  offlineStatus            String?
  prepayment               Decimal?
  remainingAmount          Decimal?
  offlinePaymentType       String?
  roomType                 RoomType?           @relation("BookingRoomType", fields: [roomTypeId], references: [id])
  roomTypeId               Int?
  assignedRoom             Room?               @relation("AssignedRoom", fields: [assignedRoomId], references: [id])
  assignedRoomId           Int?
  /// Legacy / denormalized physical room (assignedRoomId ?? roomId)
  room                     Room?               @relation(fields: [roomId], references: [id])
  roomId                   Int?
  checkIn                  DateTime
  checkOut                 DateTime
  totalPrice               Decimal
  commission               Decimal
  subtotal                 Decimal? // auditable base amount (without fees/taxes)
  serviceFee               Decimal? // platform service fee
  taxAmount                Decimal? // tax/VAT if applicable
  currency                 String              @default("TJS")
  paymentStatus            String              @default("PENDING")
  paymentMethod            String              @default("ALIF") // display label; legacy ALIF | DC | ARRIVAL still used when hotelPaymentMethodId is not set
  /// Structured hotel-owned payment method the guest selected (nullable: legacy bookings, or ARRIVAL/pay-on-site).
  hotelPaymentMethodId     Int?
  hotelPaymentMethod       HotelPaymentMethod? @relation(fields: [hotelPaymentMethodId], references: [id], onDelete: SetNull)
  /// Immutable copy of {displayLabel, recipientName, paymentIdentifier, instructions} captured at
  /// selection time, so a later edit to HotelPaymentMethod never changes what this booking shows.
  paymentMethodSnapshot    Json?
  /// Owner/admin note on reject, or admin override justification.
  paymentReviewNote        String?
  payOnArrival             Boolean             @default(false)
  phone                    String
  /// WAIT_PROOF | ON_REVIEW | PENDING_OWNER | CONFIRMED | COMPLETED | REJECTED | CANCELLED | EXPIRED
  status                   String              @default("PENDING_OWNER")
  /// Auto-expire if proof not submitted in time
  expiresAt                DateTime?
  /// Админ: пауза окна оплаты (cron не помечает как EXPIRED, пока true)
  paymentTimerPaused       Boolean             @default(false)
  /// Proof URL (MVP: user pastes link / uploads elsewhere)
  paymentProofUrl          String?
  proofSubmittedAt         DateTime?
  /// Owner must confirm/reject proof within this deadline (MVP SLA)
  proofReviewDeadlineAt    DateTime?
  proofReviewedAt          DateTime?
  proofReviewedById        Int?
  proofReviewedBy          User?               @relation("BookingProofReviewedBy", fields: [proofReviewedById], references: [id])
  /// Guest identity document (passport/ID) for verification by owner/admin
  guestDocumentUrl         String?
  guestDocumentSubmittedAt DateTime?
  /// When payment became recognized revenue (PAID). Null while unpaid/pending.
  revenueRecognizedAt      DateTime?
  /// Settlement axis independent of booking source: CASH | CARD | WALLET | BANK | OTHER
  settlementChannel        String?
  createdAt                DateTime            @default(now())

  review        Review?
  notifications Notification[]
  complaints    Complaint[]

  payment        Payment?
  payouts        Payout[]
  disputes       Dispute[]
  logs           TransactionLog[]
  chatMessages   ChatMessage[]
  deliveryChanges BookingDeliveryChange[]
  /// Когда true — активные сообщения выгружены в ChatArchive; новые сообщения запрещены.
  chatArchivedAt DateTime?

  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([roomId, checkIn, checkOut, status])
  @@index([roomTypeId, checkIn, checkOut])
  @@index([assignedRoomId])
  @@index([status])
  @@index([source])
  @@index([expiresAt])
  @@index([paymentStatus])
  @@index([revenueRecognizedAt])
  @@index([settlementChannel])
  /// booking_room_no_overlap: a Postgres EXCLUDE (gist) constraint on
  /// COALESCE(assignedRoomId, roomId) + tsrange(checkIn, checkOut, '[)'), scoped to occupying
  /// statuses only (PLATFORM: CONFIRMED/CHECKED_IN/COMPLETED; OWNER_MANUAL: CONFIRMED/CHECKED_IN).
  /// Prisma has no native EXCLUDE-constraint syntax, so it isn't declared here - see migration
  /// 20260913080000_booking_room_exclusion_constraint. This is the actual DB-level guarantee that
  /// no two occupying bookings can overlap on the same physical room, independent of any
  /// application code path. Does NOT cover room-type-only bookings with no physical room resolved
  /// yet (assignedRoomId AND roomId both null) - that case has no single column to range-exclude
  /// on and is protected at the application layer instead (see assertRoomTypeAvailable).
}

/// Активные сообщения чата по брони (после архивации удаляются, копия в ChatArchive).
model ChatMessage {
  id          Int       @id @default(autoincrement())
  bookingId   Int
  booking     Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId    Int
  senderRole  String
  senderName  String
  body        String    @default("")
  imageUrl    String?
  /// Запись из TransactionLog при миграции со старого формата.
  legacyLogId Int?      @unique
  createdAt   DateTime  @default(now())
  /// Мягкое удаление (владелец / модерация): в основном чате не показывается, в выгрузке остаётся.
  deletedAt   DateTime?
  /// Автоархив (политика хранения): не в основной ленте, доступно в выгрузке / истории.
  isArchived  Boolean   @default(false)
  /// SENT | DELIVERED | READ
  status      String    @default("SENT")
  readAt      DateTime?
  /// BLOCK 5.6D — additive semantic system-event fields. Nullable, additive-only: legacy rows
  /// keep eventType=null and continue rendering `body` verbatim (see addBookingSystemEvent()).
  /// Only SYSTEM-role rows ever populate these; guest/owner/admin chat messages never do.
  eventType    String?
  /// JSON-encoded payload for `eventType`, mirroring the existing TransactionLog.payload
  /// String-as-JSON convention already used elsewhere in this schema.
  eventPayload String?

  @@index([bookingId])
  @@index([bookingId, createdAt])
  @@index([bookingId, isArchived])
}

/// Архив переписки (сообщения старше политики хранения; активная таблица очищена).
model ChatArchive {
  id                Int      @id @default(autoincrement())
  bookingId         Int
  senderId          Int
  senderRole        String
  senderName        String
  body              String   @default("")
  imageUrl          String?
  originalCreatedAt DateTime
  archivedAt        DateTime @default(now())

  @@index([bookingId])
}

/// Owner verification + KYC-like profile.
model HostProfile {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  legalName    String?
  businessName String?
  documentUrl  String?
  kycStatus    String   @default("PENDING") // PENDING | APPROVED | REJECTED
  riskScore    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Payment transaction linked to booking (auditable).
model Payment {
  id          Int      @id @default(autoincrement())
  bookingId   Int      @unique
  booking     Booking  @relation(fields: [bookingId], references: [id])
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  provider    String   @default("MANUAL") // MANUAL | CARD | LOCAL | WALLET
  method      String   @default("card")
  status      String   @default("PENDING") // PENDING | AUTHORIZED | CAPTURED | FAILED | REFUNDED
  currency    String   @default("TJS")
  amount      Decimal
  fee         Decimal  @default(0) // processor fee if needed
  externalRef String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  refunds Refund[]
  logs    TransactionLog[]

  @@index([userId])
  @@index([status])
}

/// Payout to host after escrow release.
model Payout {
  id          Int       @id @default(autoincrement())
  bookingId   Int
  booking     Booking   @relation(fields: [bookingId], references: [id])
  ownerId     Int
  owner       User      @relation("UserPayouts", fields: [ownerId], references: [id])
  currency    String    @default("TJS")
  amount      Decimal
  status      String    @default("PENDING") // PENDING | SENT | FAILED
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  externalRef String?

  @@index([ownerId])
  @@index([status])
}

/// Refund linked to a payment.
model Refund {
  id          Int       @id @default(autoincrement())
  paymentId   Int
  payment     Payment   @relation(fields: [paymentId], references: [id])
  amount      Decimal
  currency    String    @default("TJS")
  reason      String?
  status      String    @default("PENDING") // PENDING | SENT | FAILED
  createdAt   DateTime  @default(now())
  sentAt      DateTime?
  externalRef String?

  @@index([paymentId])
}

/// Immutable-ish event log for finance and booking actions.
model TransactionLog {
  id        Int      @id @default(autoincrement())
  bookingId Int?
  booking   Booking? @relation(fields: [bookingId], references: [id])
  paymentId Int?
  payment   Payment? @relation(fields: [paymentId], references: [id])
  type      String
  payload   String? // JSON string
  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([paymentId])
  @@index([type])
}

/// Photos gallery for hotel page.
model HotelPhoto {
  id        Int      @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([hotelId])
}

/// Normalized amenities per hotel (future-proof).
model HotelAmenity {
  id        Int      @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  key       String
  createdAt DateTime @default(now())

  @@unique([hotelId, key])
}

/// Disputes/claims (separate from complaint).
model Dispute {
  id         Int       @id @default(autoincrement())
  bookingId  Int
  booking    Booking   @relation(fields: [bookingId], references: [id])
  openedById Int
  openedBy   User      @relation("DisputesOpened", fields: [openedById], references: [id])
  againstId  Int
  against    User      @relation("DisputesAgainst", fields: [againstId], references: [id])
  reason     String
  status     String    @default("OPEN") // OPEN | RESOLVED | REJECTED
  resolution String?
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([bookingId])
  @@index([status])
}

model Review {
  id        Int      @id @default(autoincrement())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId Int      @unique
  rating    Int
  comment   String
  imageUrl  String?
  reply     String?
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  title     String?
  message   String?
  link      String?
  meta      String?
  user      User     @relation("UserNotifications", fields: [userId], references: [id])
  userId    Int
  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// MASTER COMPLETION BLOCK, PHASE B: real, backend-enforced notification category preferences —
/// replaces the previous `/profile/subscriptions` UI, which only wrote to localStorage and had
/// zero server-side effect (topics/channels that looked functional but did nothing). Only the two
/// categories with a real, already-existing notification-sending code path are exposed
/// (security/login alerts, booking status) — a "Promotions" category is intentionally NOT added
/// yet because no promotional-notification sending mechanism exists in this codebase yet; adding
/// a toggle for a feature that doesn't exist would be exactly the "decorative control" this block
/// forbids. Disabling a category only suppresses the *push* notification for it — the in-app
/// Notification row (and therefore the inbox/audit trail) is always created regardless, so a user
/// can never fully hide evidence of a security event from their own account history.
model NotificationPreference {
  id             Int      @id @default(autoincrement())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         Int      @unique
  security       Boolean  @default(true)
  bookingUpdates Boolean  @default(true)
  updatedAt      DateTime @updatedAt
}

/// Web Push subscription for installed PWA (requires VAPID keys on server).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Complaint {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId Int
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Session {
  id           Int       @id @default(autoincrement())
  sessionToken String?   @unique
  token        String?   @unique
  userId       Int
  expires      DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailOtp {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  email     String
  codeHash  String
  /// PASSWORD_RESET (reserved for future purposes).
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@index([userId, purpose])
}

model OtpChallenge {
  id          Int       @id @default(autoincrement())
  phone       String    @unique
  codeHash    String
  expiresAt   DateTime
  usedAt      DateTime?
  attempts    Int       @default(0)
  lockedUntil DateTime?
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Favorite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  hotelId   Int
  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
}

// Singleton (id=1): LEGACY — secretWordHash is no longer used for AuthN/AuthZ (P0-S1).
// Column retained for safe later migration; do not read/write for authorization.
model AdminSecurityState {
  id             Int      @id @default(1)
  secretWordHash String?
  updatedAt      DateTime @updatedAt
}

/// Singleton (id=1): editable site content (banner, brand, legal, support, payment catalog).
model SiteContentState {
  id        Int      @id @default(1)
  content   Json
  updatedAt DateTime @updatedAt
}

/// Auth security / audit events (OTP, login, suspicious activity).
/// One-time login via @TajstayBot (/start login_<token>).
model TelegramLoginChallenge {
  id                Int       @id @default(autoincrement())
  token             String    @unique
  codeHash          String
  telegramId        String?
  telegramUsername  String?
  telegramFirstName String?
  telegramPhotoUrl  String?
  phone             String?
  attemptCount      Int       @default(0)
  lastCodeSentAt    DateTime?
  expiresAt         DateTime
  verifiedAt        DateTime?
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([expiresAt])
  @@index([telegramId])
}

model AuthAuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  event     String
  ip        String?
  userAgent String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

/// Append-only admin / ops audit trail (mutations). Do not store secrets.
model AdminAuditLog {
  id            Int      @id @default(autoincrement())
  actorUserId   Int?
  action        String
  targetType    String?
  targetId      String?
  beforeState   String?
  afterState    String?
  reason        String?
  metadata      String?
  correlationId String?
  ip            String?
  userAgent     String?
  result        String   @default("ok")
  createdAt     DateTime @default(now())

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

/// Per-owner payment requisites shown to guests during checkout / booking room.
/// Deprecated in favor of HotelPaymentMethod (payment requisites belong to a Hotel, not an Owner
/// account, since one owner can run several hotels with different requisites) - kept for now,
/// no longer written to or read from any live page.
model OwnerPaymentMethod {
  ownerId   Int      @id
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  methods   String[] @default([])
  updatedAt DateTime @updatedAt
}

/// Structured payment requisites belonging to a specific Hotel, managed by that hotel's owner.
/// Booking captures an immutable snapshot (Booking.paymentMethodSnapshot) at selection time, so
/// editing/removing a method here never retroactively changes what an existing booking shows.
model HotelPaymentMethod {
  id                Int      @id @default(autoincrement())
  hotelId           Int
  hotel             Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  /// CARD | WALLET | BANK | OTHER
  type              String
  displayLabel      String
  recipientName     String
  /// Card/account/wallet number shown to the guest - sensitive, mask in logs/notifications.
  paymentIdentifier String
  instructions      String?
  isActive          Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  bookings Booking[]

  @@index([hotelId])
  @@index([hotelId, isActive])
}

/// Hotel-scoped operational expense (owner-entered). Amount history lives in versions —
/// never mutate past version amounts; stop by closing effectiveUntil.
model HotelExpense {
  id              Int      @id @default(autoincrement())
  hotelId         Int
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  title           String
  /// ELECTRICITY | WATER | INTERNET | SALARY | CLEANING | LAUNDRY | REPAIR | SUPPLIES | FOOD | TRANSPORT | TAX | UTILITIES | OTHER
  category        String
  currency        String   @default("TJS")
  /// ONE_TIME | MONTHLY
  recurrence      String
  /// ACTIVE | STOPPED | ARCHIVED
  status          String   @default("ACTIVE")
  createdByUserId Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  versions        HotelExpenseVersion[]

  @@index([hotelId])
  @@index([hotelId, status])
  @@index([hotelId, category])
}

model HotelExpenseVersion {
  id              Int       @id @default(autoincrement())
  expenseId       Int
  expense         HotelExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount          Decimal
  /// Inclusive calendar-day start (UTC midnight of business day).
  effectiveFrom   DateTime
  /// Exclusive end; null = open-ended (still active).
  effectiveUntil  DateTime?
  createdByUserId Int
  createdAt       DateTime  @default(now())
  note            String?

  @@index([expenseId])
  @@index([expenseId, effectiveFrom])
  @@index([effectiveFrom, effectiveUntil])
}

/// Append-only owner hotel activity log. Never store secrets / full card numbers.
model OwnerHotelAuditLog {
  id            Int      @id @default(autoincrement())
  hotelId       Int
  hotel         Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  actorUserId   Int?
  actorRole     String?
  action        String
  entityType    String?
  entityId      String?
  beforeState   String?
  afterState    String?
  metadata      String?
  createdAt     DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([hotelId, action])
  @@index([actorUserId])
}

// =============================================================================
// Local Vault — Phase 2B.1 (activation / device binding / PoP / durable RL)
// Additive only. Isolated domain under /api/local-vault/**
// =============================================================================

enum LocalVaultDeviceStatus {
  ACTIVE
  REVOKED
}

/// One-time hotel activation code. Plaintext returned to Owner once at creation.
/// Lookup: HMAC-SHA256(LOCAL_VAULT_CODE_PEPPER, normalizedCode) → codeDigest (hex).
model LocalVaultActivationCode {
  id              String    @id @default(cuid())
  /// Hex-encoded HMAC-SHA256 digest (64 chars). Never store plaintext code.
  codeDigest      String    @unique
  hotelId         Int
  hotel           Hotel     @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  createdByUserId Int?
  createdByUser   User?     @relation("LocalVaultCodeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  expiresAt       DateTime
  usedAt          DateTime?
  usedByDeviceId  String?
  createdAt       DateTime  @default(now())

  @@index([hotelId])
  @@index([expiresAt])
}

/// Bound Local Vault desktop installation for exactly one Hotel.
/// Invariant: one installationId ↔ one deviceId ↔ one Ed25519 publicKey (all UNIQUE).
/// REVOKED + same identity + fresh code + valid PoP → reactivate same row (no new keypair).
model LocalVaultDeviceBinding {
  id                String                 @id @default(cuid())
  deviceId          String                 @unique
  installationId    String                 @unique
  /// Ed25519 public key, base64url without padding.
  publicKey         String                 @unique
  /// SHA-256(raw 32-byte public key) as lowercase hex.
  publicKeyFp       String                 @unique
  hotelId           Int
  hotel             Hotel                  @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  status            LocalVaultDeviceStatus @default(ACTIVE)
  platform          String
  architecture      String
  appVersion        String?
  activatedAt       DateTime               @default(now())
  activatedByUserId Int?
  activatedByUser   User?                  @relation("LocalVaultDeviceActivatedBy", fields: [activatedByUserId], references: [id], onDelete: SetNull)
  lastSeenAt        DateTime?
  revokedAt         DateTime?
  revokedByUserId   Int?
  revokedByUser     User?                  @relation("LocalVaultDeviceRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  revokeReason      String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([hotelId, status])
  @@index([lastSeenAt])
}

/// Replay protection. subjectKey: activate:<publicKeyFp> | device:<deviceId>
model LocalVaultUsedNonce {
  id         String   @id @default(cuid())
  subjectKey String
  nonce      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@unique([subjectKey, nonce])
  @@index([expiresAt])
}

/// Durable multi-instance rate limiter (PostgreSQL).
model LocalVaultRateBucket {
  id        String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

/// Append-only Local Vault security/ops events. No secrets / no plaintext codes.
/// Append-only change log that makes a Booking deliverable to a hotel's Local Vault device.
///
/// Why a change log rather than `updatedAt > clientTimestamp`: a timestamp cursor silently drops
/// rows that share a timestamp, and a row whose transaction started earlier can commit later than
/// one with a newer timestamp — the client would advance past it and never see it again. `id` here
/// is a monotonic sequence written INSIDE the same transaction as the Booking mutation, so a
/// change is never visible before the Booking it describes (and never lost after it commits).
///
/// Residual boundary, documented rather than hidden: autoincrement ids are assigned at INSERT but
/// become visible at COMMIT, so a lower id can appear after a higher one under concurrency. The
/// snapshot endpoint re-reads the full operational window and is the reconciliation path that
/// self-heals any such gap; incremental sync is the fast path, not the only path.
model BookingDeliveryChange {
  id         Int      @id @default(autoincrement())
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId  Int
  hotel      Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId    Int
  /// Per-hotel monotonic cursor. Allocated by locking HotelDeliveryCursor inside the SAME
  /// transaction as the Booking mutation, so a concurrent mutation for this hotel blocks until
  /// this one commits. Commit order therefore equals revision order and no revision can become
  /// visible out of sequence — this is what makes incremental sync gap-free (NOT `id`, which is
  /// assigned at INSERT and can commit out of order).
  revision   Int
  /// CREATED | UPDATED | CANCELLED — an explicit event, so the device never infers deletion from absence.
  changeType String
  createdAt  DateTime @default(now())

  @@unique([hotelId, revision])
  @@index([hotelId, revision])
  @@index([bookingId])
}

/// Per-hotel revision allocator. One row per hotel; the row lock taken by the allocating UPDATE
/// is what serializes delivery-change creation for that hotel.
model HotelDeliveryCursor {
  hotelId      Int      @id
  hotel        Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  lastRevision Int      @default(0)
  updatedAt    DateTime @updatedAt
}

model LocalVaultAuditEvent {
  id          String   @id @default(cuid())
  hotelId     Int?
  deviceId    String?
  actorUserId Int?
  action      String
  metadata    String?
  createdAt   DateTime @default(now())

  @@index([hotelId, createdAt])
  @@index([deviceId, createdAt])
  @@index([action, createdAt])
}

