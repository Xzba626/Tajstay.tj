generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL — pooled Neon URL for the app at runtime (?sslmode=require).
// DIRECT_URL — non-pooler host for prisma migrate (advisory locks fail through pooler).
// If Prisma says "URL must start with file:" your generated client still matches sqlite — run: npx prisma generate
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  firstName String?
  lastName  String?
  preferredCurrency String?
  preferredTheme    String   @default("system")
  phone     String   @unique
  email     String?  @unique
  emailVerified DateTime?
  image     String?
  password  String
  /// Firebase Auth UID after phone sign-in (production SMS OTP).
  firebaseUid   String?  @unique
  /// True when phone was verified via Firebase Phone Auth (or legacy OTP).
  phoneVerified Boolean  @default(false)
  /// Telegram user id (string for large ids).
  telegramId        String?  @unique
  telegramUsername  String?
  telegramPhotoUrl  String?
  role      String   @default("GUEST")
  verified  Boolean  @default(false)
  isBanned  Boolean   @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hotels              Hotel[]             @relation("OwnerHotels")
  bookings            Booking[]           @relation("BookingUser")
  offlineBookingsCreated Booking[]          @relation("BookingsCreatedByOwner")
  reviewedBookings    Booking[]           @relation("BookingProofReviewedBy")
  notes               Notification[]      @relation("UserNotifications")
  sessions            Session[]
  passwordResetTokens       PasswordResetToken[]
  emailVerificationTokens   EmailVerificationToken[]
  emailOtps                 EmailOtp[]
  favorites           Favorite[]
  complaints          Complaint[]
  accounts            Account[]
  ownerApplications   OwnerApplication[]  @relation("OwnerApplications")
  reviewedOwnerApps   OwnerApplication[]  @relation("OwnerApplicationReviewedBy")

  hostProfile         HostProfile?
  paymentMethodsEntry OwnerPaymentMethod?
  payments            Payment[]
  payouts             Payout[]            @relation("UserPayouts")
  disputesOpened      Dispute[]           @relation("DisputesOpened")
  disputesAgainst     Dispute[]           @relation("DisputesAgainst")
  pushSubscriptions   PushSubscription[]
  telegramChangeRequests TelegramChangeRequest[]
  deviceSessions      UserDeviceSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

/// Заявка на статус владельца; доступ к owner panel только после APPROVED.
model OwnerApplication {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation("OwnerApplications", fields: [userId], references: [id])
  fullName     String
  phone        String
  email        String
  businessName String
  documentUrl  String?
  comment      String?
  /// Extended onboarding: property details, upload URLs, applicant type (JSON).
  applicationMeta Json?
  status       String    @default("PENDING")
  createdAt    DateTime  @default(now())
  reviewedAt   DateTime?
  reviewedById Int?
  reviewedBy   User?     @relation("OwnerApplicationReviewedBy", fields: [reviewedById], references: [id])
}

model Hotel {
  id             Int      @id @default(autoincrement())
  owner          User     @relation("OwnerHotels", fields: [ownerId], references: [id])
  ownerId        Int
  name           String
  city           String
  address        String
  description    String
  propertyType   String   @default("HOTEL")
  /// URL обложки (внешняя ссылка или /uploads/…)
  coverImageUrl  String?
  rating         Float    @default(0)
  status           String    @default("PENDING")
  rejectionReason  String?
  deletedAt        DateTime?
  latitude         Float
  longitude        Float
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  rooms      Room[]
  roomTypes  RoomType[]
  staff      HotelStaff[]
  favorites  Favorite[]

  photos    HotelPhoto[]
  amenities HotelAmenity[]
}

/// Категория номера (то, что видит гость): Стандарт, Полулюкс, …
model RoomType {
  id              Int      @id @default(autoincrement())
  hotel           Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  hotelId         Int
  name            String
  description     String?
  basePrice       Decimal
  weekendPrice    Decimal?
  minNights       Int      @default(1)
  extraGuestPrice Decimal?
  adults          Int      @default(2)
  children        Int      @default(0)
  maxGuests       Int
  bedsCount       Int      @default(1)
  /// JSON: ["double","twin","sofa",…]
  bedConfig       String   @default("[]")
  /// ROOM_ONLY | BREAKFAST | HALF_BOARD | FULL_BOARD
  mealPlan        String   @default("ROOM_ONLY")
  /// JSON categorized amenities (see lib/pms/amenities.ts)
  amenities       String   @default("[]")
  sortOrder       Int      @default(0)
  availability    Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  rooms       Room[]
  bookings    Booking[]    @relation("BookingRoomType")
  ratePlans   RatePlan[]
  photos      RoomTypePhoto[]

  @@unique([hotelId, name])
  @@index([hotelId])
}

model RoomTypePhoto {
  id         Int      @id @default(autoincrement())
  roomTypeId Int
  roomType   RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  url        String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([roomTypeId])
}

/// Тариф (MVP: привязан к категории)
model RatePlan {
  id          Int      @id @default(autoincrement())
  roomTypeId  Int
  roomType    RoomType @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  name        String
  /// Overrides meal on type when set
  mealPlan    String?
  refundable  Boolean  @default(true)
  isDefault   Boolean  @default(false)
  priceAdjust Decimal  @default(0)
  createdAt   DateTime @default(now())

  @@index([roomTypeId])
}

/// Физическая комната (101, 102, A-12) — управление владельцем/ресепшеном
model Room {
  id           Int     @id @default(autoincrement())
  hotel        Hotel   @relation(fields: [hotelId], references: [id])
  hotelId      Int
  roomType     RoomType? @relation(fields: [roomTypeId], references: [id])
  roomTypeId   Int?
  /// Номер комнаты в отеле (уникален в рамках hotelId)
  roomNumber   String?
  title        String
  price        Decimal
  weekendPrice Decimal?
  minNights    Int      @default(1)
  extraGuestPrice Decimal?
  capacity     Int
  amenities    String // JSON stringified array (legacy + custom)
  /// JSON: extra amenities only on this physical room
  customAmenities String @default("[]")
  availability Boolean @default(true)
  /// ACTIVE | OUT_OF_SERVICE | MAINTENANCE | CLEANING | DIRTY | INSPECTED | HIDDEN | ARCHIVED
  status       String   @default("ACTIVE")
  /// CLEAN | DIRTY | CLEANING | INSPECTED
  housekeepingStatus String @default("CLEAN")
  staffNote    String?

  overrides       RoomDateOverride[]
  bookings        Booking[]
  assignedBookings Booking[] @relation("AssignedRoom")
  photos          RoomPhoto[]

  @@unique([hotelId, roomNumber])
  @@index([hotelId])
  @@index([roomTypeId])
  @@index([status])
}

/// Сотрудники отеля (ресепшен / housekeeping)
model HotelStaff {
  id        Int      @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel    @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  userId    Int
  /// RECEPTIONIST | HOUSEKEEPING
  staffRole String
  createdAt DateTime @default(now())

  @@unique([hotelId, userId])
  @@index([userId])
}

/// Фото номера (галерея / слайдер на карточке и странице отеля).
model RoomPhoto {
  id        Int      @id @default(autoincrement())
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([roomId])
}

model RoomDateOverride {
  id          Int      @id @default(autoincrement())
  room        Room     @relation(fields: [roomId], references: [id])
  roomId      Int
  date        DateTime
  customPrice Decimal?
  isBlocked   Boolean  @default(false)

  @@unique([roomId, date])
}

model Booking {
  id            Int      @id @default(autoincrement())
  /// Public short code, e.g. TJ-7704 (shown to user for transfer comment)
  publicCode    String?  @unique
  /// PLATFORM = guest checkout; OWNER_MANUAL = offline booking by host
  source        String   @default("PLATFORM")
  user          User?    @relation("BookingUser", fields: [userId], references: [id])
  userId        Int?
  createdByOwner   User?  @relation("BookingsCreatedByOwner", fields: [createdByOwnerId], references: [id])
  createdByOwnerId Int?
  guestName     String?
  guestPhone    String?
  guestEmail    String?
  guestCount    Int      @default(1)
  offlineNote   String?
  /// OWNER_MANUAL lifecycle: PENDING | CONFIRMED | CHECKED_IN | CHECKED_OUT | CANCELLED
  offlineStatus String?
  prepayment       Decimal?
  remainingAmount  Decimal?
  offlinePaymentType String?
  roomType      RoomType? @relation("BookingRoomType", fields: [roomTypeId], references: [id])
  roomTypeId    Int?
  assignedRoom  Room?     @relation("AssignedRoom", fields: [assignedRoomId], references: [id])
  assignedRoomId Int?
  /// Legacy / denormalized physical room (assignedRoomId ?? roomId)
  room          Room?     @relation(fields: [roomId], references: [id])
  roomId        Int?
  checkIn       DateTime
  checkOut      DateTime
  totalPrice    Decimal
  commission    Decimal
  subtotal      Decimal?  // auditable base amount (without fees/taxes)
  serviceFee    Decimal?  // platform service fee
  taxAmount     Decimal?  // tax/VAT if applicable
  currency      String    @default("TJS")
  paymentStatus String   @default("PENDING")
  paymentMethod String   @default("ALIF") // ALIF | DC | ARRIVAL (MVP)
  payOnArrival  Boolean  @default(false)
  phone         String
  /// WAIT_PROOF | ON_REVIEW | PENDING_OWNER | CONFIRMED | COMPLETED | REJECTED | CANCELLED | EXPIRED
  status        String   @default("PENDING_OWNER")
  /// Auto-expire if proof not submitted in time
  expiresAt     DateTime?
  /// Админ: пауза окна оплаты (cron не помечает как EXPIRED, пока true)
  paymentTimerPaused Boolean @default(false)
  /// Proof URL (MVP: user pastes link / uploads elsewhere)
  paymentProofUrl String?
  proofSubmittedAt DateTime?
  /// Owner must confirm/reject proof within this deadline (MVP SLA)
  proofReviewDeadlineAt DateTime?
  proofReviewedAt  DateTime?
  proofReviewedById Int?
  proofReviewedBy   User?   @relation("BookingProofReviewedBy", fields: [proofReviewedById], references: [id])
  /// Guest identity document (passport/ID) for verification by owner/admin
  guestDocumentUrl String?
  guestDocumentSubmittedAt DateTime?
  createdAt     DateTime @default(now())

  review        Review?
  notifications Notification[]
  complaints    Complaint[]

  payment       Payment?
  payouts       Payout[]
  disputes      Dispute[]
  logs          TransactionLog[]
  chatMessages  ChatMessage[]
  /// Когда true — активные сообщения выгружены в ChatArchive; новые сообщения запрещены.
  chatArchivedAt DateTime?

  @@index([userId])
  @@index([roomId, checkIn, checkOut])
  @@index([roomId, checkIn, checkOut, status])
  @@index([roomTypeId, checkIn, checkOut])
  @@index([assignedRoomId])
  @@index([status])
  @@index([source])
  @@index([expiresAt])
}

/// Активные сообщения чата по брони (после архивации удаляются, копия в ChatArchive).
model ChatMessage {
  id          Int      @id @default(autoincrement())
  bookingId   Int
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  senderId    Int
  senderRole  String
  senderName  String
  body        String   @default("")
  imageUrl    String?
  /// Запись из TransactionLog при миграции со старого формата.
  legacyLogId Int?     @unique
  createdAt   DateTime @default(now())
  /// Мягкое удаление (владелец / модерация): в основном чате не показывается, в выгрузке остаётся.
  deletedAt   DateTime?
  /// Автоархив (политика хранения): не в основной ленте, доступно в выгрузке / истории.
  isArchived  Boolean  @default(false)
  /// SENT | DELIVERED | READ
  status      String   @default("SENT")
  readAt      DateTime?

  @@index([bookingId])
  @@index([bookingId, createdAt])
  @@index([bookingId, isArchived])
}

/// Архив переписки (сообщения старше политики хранения; активная таблица очищена).
model ChatArchive {
  id                Int      @id @default(autoincrement())
  bookingId         Int
  senderId          Int
  senderRole        String
  senderName        String
  body              String   @default("")
  imageUrl          String?
  originalCreatedAt DateTime
  archivedAt        DateTime @default(now())

  @@index([bookingId])
}

/// Owner verification + KYC-like profile.
model HostProfile {
  id              Int      @id @default(autoincrement())
  userId          Int      @unique
  user            User     @relation(fields: [userId], references: [id])
  legalName       String?
  businessName    String?
  documentUrl     String?
  kycStatus       String   @default("PENDING") // PENDING | APPROVED | REJECTED
  riskScore       Int      @default(0)
  /// PMS prefs: offline cloud sync, backup channels (JSON)
  pmsSettings     Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Payment transaction linked to booking (auditable).
model Payment {
  id            Int      @id @default(autoincrement())
  bookingId     Int      @unique
  booking       Booking  @relation(fields: [bookingId], references: [id])
  userId        Int
  user          User     @relation(fields: [userId], references: [id])
  provider      String   @default("MANUAL") // MANUAL | CARD | LOCAL | WALLET
  method        String   @default("card")
  status        String   @default("PENDING") // PENDING | AUTHORIZED | CAPTURED | FAILED | REFUNDED
  currency      String   @default("TJS")
  amount        Decimal
  fee           Decimal  @default(0) // processor fee if needed
  externalRef   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  refunds       Refund[]
  logs          TransactionLog[]

  @@index([userId])
  @@index([status])
}

/// Payout to host after escrow release.
model Payout {
  id          Int      @id @default(autoincrement())
  bookingId   Int
  booking     Booking  @relation(fields: [bookingId], references: [id])
  ownerId     Int
  owner       User     @relation("UserPayouts", fields: [ownerId], references: [id])
  currency    String   @default("TJS")
  amount      Decimal
  status      String   @default("PENDING") // PENDING | SENT | FAILED
  createdAt   DateTime @default(now())
  sentAt      DateTime?
  externalRef String?

  @@index([ownerId])
  @@index([status])
}

/// Refund linked to a payment.
model Refund {
  id         Int      @id @default(autoincrement())
  paymentId  Int
  payment    Payment  @relation(fields: [paymentId], references: [id])
  amount     Decimal
  currency   String   @default("TJS")
  reason     String?
  status     String   @default("PENDING") // PENDING | SENT | FAILED
  createdAt  DateTime @default(now())
  sentAt     DateTime?
  externalRef String?

  @@index([paymentId])
}

/// Immutable-ish event log for finance and booking actions.
model TransactionLog {
  id         Int      @id @default(autoincrement())
  bookingId  Int?
  booking    Booking? @relation(fields: [bookingId], references: [id])
  paymentId  Int?
  payment    Payment? @relation(fields: [paymentId], references: [id])
  type       String
  payload    String?  // JSON string
  createdAt  DateTime @default(now())

  @@index([bookingId])
  @@index([paymentId])
  @@index([type])
}

/// Photos gallery for hotel page.
model HotelPhoto {
  id        Int      @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([hotelId])
}

/// Normalized amenities per hotel (future-proof).
model HotelAmenity {
  id        Int      @id @default(autoincrement())
  hotelId   Int
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  key       String
  createdAt DateTime @default(now())

  @@unique([hotelId, key])
}

/// Disputes/claims (separate from complaint).
model Dispute {
  id          Int      @id @default(autoincrement())
  bookingId   Int
  booking     Booking  @relation(fields: [bookingId], references: [id])
  openedById  Int
  openedBy    User     @relation("DisputesOpened", fields: [openedById], references: [id])
  againstId   Int
  against     User     @relation("DisputesAgainst", fields: [againstId], references: [id])
  reason      String
  status      String   @default("OPEN") // OPEN | RESOLVED | REJECTED
  resolution  String?
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@index([bookingId])
  @@index([status])
}

model Review {
  id        Int      @id @default(autoincrement())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId Int      @unique
  rating    Int
  comment   String
  imageUrl  String?
  reply     String?
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  type      String
  title     String?
  message   String?
  link      String?
  meta      String?
  user      User     @relation("UserNotifications", fields: [userId], references: [id])
  userId    Int
  booking   Booking? @relation(fields: [bookingId], references: [id])
  bookingId Int?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

/// Web Push subscription for installed PWA (requires VAPID keys on server).
model PushSubscription {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Complaint {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId Int
  message   String
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String?  @unique
  token        String?  @unique
  userId       Int
  expires      DateTime?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int      @unique
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model EmailOtp {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  email     String
  codeHash  String
  /// PASSWORD_RESET | CHANGE_EMAIL
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([userId, purpose])
}

model OtpChallenge {
  id        Int       @id @default(autoincrement())
  phone     String    @unique
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0)
  lockedUntil DateTime?
  lastSentAt DateTime?
  createdAt DateTime  @default(now())
}

model Favorite {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
  hotel     Hotel    @relation(fields: [hotelId], references: [id])
  hotelId   Int
  createdAt DateTime @default(now())

  @@unique([userId, hotelId])
}

// Singleton (id=1): admin secret word hash for security form (not the login password).
model AdminSecurityState {
  id             Int      @id @default(1)
  secretWordHash String?
  updatedAt      DateTime @updatedAt
}

/// Singleton (id=1): editable site content (banner, brand, legal, support, payment catalog).
model SiteContentState {
  id        Int      @id @default(1)
  content   Json
  updatedAt DateTime @updatedAt
}

/// Auth security / audit events (OTP, login, suspicious activity).
/// One-time login via @TajstayBot (/start login_<token>).
/// Profile-only Telegram change (not login/register).
model TelegramChangeRequest {
  id                Int       @id @default(autoincrement())
  userId            Int
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken      String    @unique
  codeHash          String?
  telegramId        String?
  telegramUsername  String?
  telegramFirstName String?
  telegramPhotoUrl  String?
  expiresAt         DateTime
  usedAt            DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, usedAt])
  @@index([telegramId])
  @@index([expiresAt])
}

model TelegramLoginChallenge {
  id                 Int       @id @default(autoincrement())
  token              String    @unique
  codeHash           String
  /// When set, successful verification links Telegram to this user instead of login/register.
  telegramId         String?
  telegramUsername   String?
  telegramFirstName  String?
  telegramPhotoUrl   String?
  phone              String?
  attemptCount       Int       @default(0)
  lastCodeSentAt     DateTime?
  expiresAt          DateTime
  verifiedAt         DateTime?
  usedAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([expiresAt])
  @@index([telegramId])
}

model AuthAuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  event     String
  ip        String?
  userAgent String?
  meta      String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

/// Latest device fingerprint per user (server IP/geo/UA + client language/screen).
model UserDeviceSession {
  id             Int      @id @default(autoincrement())
  userId         Int
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ip             String?
  city           String?
  countryCode    String?
  userAgent      String?
  systemLanguage String?
  screenWidth    Int?
  screenHeight   Int?
  lastSeenAt     DateTime @default(now()) @updatedAt
  createdAt      DateTime @default(now())

  @@index([userId, lastSeenAt])
}

/// Per-owner payment requisites shown to guests during checkout / booking room.
model OwnerPaymentMethod {
  ownerId   Int      @id
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  methods   String[] @default([])
  updatedAt DateTime @updatedAt
}